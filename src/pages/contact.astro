---
import MainLayout from "../layouts/MainLayout.astro";
import Content from "../components/layout/Content.astro";
import Hero from "../components/ui/Hero.astro";
import TwoColumns from "../components/ui/TwoColumns.astro";
import ContactForm from "../components/form/ContactForm.astro";
import Button from "../components/ui/Button.astro";

import { Icon } from "astro-icon/components";
---

<MainLayout
  title="Yhteystiedot | Christa Eloranta"
  description="Lähetä viestit, terveiset, ehdotukset yhteistyökuvioista, kyselyt tilaustuotteista ja ideoista sekä työtarjoukset. Juonitaan jotain yhdessä!"
>
  <Hero
    imageUrl="images/Palttina2.svg"
    imageClass="md:bg-[length:15%] bg-[length:75%]"
  >
    <Fragment slot="title"
      ><span class="text-brand-highlight">Juonitaan</span><br />jotain</Fragment
    >
    <Fragment slot="description">
      Yhteistyökuviot, tilaustuotteet, ideat, sparrailu, keittiöpyyhkeet,
      työtarjoukset, pehmolelut, suunnitelmat..
    </Fragment>
  </Hero>

  <Content>
    <TwoColumns
      containerClass="!gap-12"
      column1Class="bg-brand text-surface-primary p-4 md:p-8 rounded-md shadow-md"
    >
      <Fragment slot="column1">
        <h2 class="text-2xl font-serif-secondary mb-4">
          <span class="text-3xl text-content-secondary">Slaidaa</span> matalalla kynnyksellä
          DMiin tai lähetä verkostoitumispyyntöä
        </h2>
        <div class="flex flex-col justify-start items-start mt-4 gap-4">
          <span
            class="inline-flex gap-4 items-center font-sans-secondary leading-6 tracking-tight"
            ><Icon name="email-8-svgrepo-com" /> eloranta.christa@gmail.com</span
          >
          <Button
            variant="textLink"
            class="text-surface-primary normal-case! p-0! gap-4 md:text-base!"
            href="https://www.linkedin.com/in/christa-eloranta/"
            ><Icon name="linkedin-161-svgrepo-com" />Christa Eloranta</Button
          >
          <Button
            variant="textLink"
            class="text-surface-primary normal-case! p-0! gap-4 md:text-base!"
            href="https://www.instagram.com/christaeloranta/"
            ><Icon name="instagram-svgrepo-com" />christaeloranta</Button
          >
          <span
            class="inline-flex gap-4 items-center font-sans-secondary leading-6 tracking-tight"
            ><Icon name="location-pin-svgrepo-com" /> Tampere, Suomi</span
          >
        </div>
      </Fragment>
      <Fragment slot="column2">
        <ContactForm />
      </Fragment>
    </TwoColumns>
  </Content>
</MainLayout>
