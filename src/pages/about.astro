---
import Content from "../components/layout/Content.astro";
import Hero from "../components/ui/Hero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import TimelineAccordion from "../components/ui/TimelineAccordion.astro";
import TimelineAccordionItem from "../components/ui/TimelineAccordionItem.astro";

import { Icon } from "astro-icon/components";
import Tag from "../components/ui/Tag.astro";
import TwoColumns from "../components/ui/TwoColumns.astro";
---

<MainLayout title="Minusta">
  <Hero
    imageUrl="lonkeroraportti2.svg"
    imageClass="md:bg-[length:65%] bg-[length:100%]"
  >
    <Fragment slot="tags">
      <Tag>monipuolinen</Tag>
      <Tag>luova</Tag>
      <Tag>utelias</Tag>
    </Fragment>
    <Fragment slot="title"
      ><span class="text-brand-highlight italic">Christa</span><br
      />Eloranta</Fragment
    >
    <Fragment slot="description">
      Tieto- ja viestintätekniikan insinööri, taiteen kakdidaatti, puuseppä,
      sisustaja, baarimestari. Koodari, käsityöläinen, suunnittelija,
      juonittelija, tuuliviiri.
    </Fragment>
  </Hero>
  <Content>
    <TwoColumns
      containerClass="bg-surface-secondary md:p-8 p-4 rounded-sm"
      column1Class="order-2 md:order-1 bg-surface-primary md:p-8 p-4 shadow-md rounded-sm !md:w-full"
      column2Class="order-1 md:order-2 justify-center !md:w-fit"
      reveal
    >
      <Fragment slot="column1">
        <h2 class="text-3xl font-serif-secondary italic mb-4">Meitsi</h2>
        <p>
          Olen utelias ja muutoksella käyvä tuuliviiri. En kulje väkisin
          vastatuuleen, vaan minulle on luontevaa vaihtaa suuntaa tarvittaessa.
          Kirjava tausta ei johdu määrätietoisuuden puutteesta vaan on tapa
          kerätä osaamisista kokonaisuus, jota harvalla on.
        </p>
        <p class="pt-4">
          Taustani on yökerho- ja karaokemaailmassa, minkä ansiosta
          asiakaslähtöisyys on oletusasetus tekemisessäni, enkä hätkähdä
          erikoisia ja muuttuvia tilanteita. Muotoiluopinnoissa olen saanut
          vahvan pohjan käyttäjälähtöiselle suunnittelulle ja hienopuusepäksi
          opiskellessani silmäni yksityiskohdille vahvistui entisestään.
          Koodarina olen oppinut ratkaisemaan ongelmia loogisesti ja tehokkaasti
          ja luomaan tuotteista toimivia.
        </p>
        <p class="pt-4">
          Ohjelmistoala elää jatkuvassa muutoksessa — ja siinä laaja-alaisuus on
          oikeasti kilpailuetu, ei kompromissi. Monipuolinen osaaminen ei
          tarkoita, että tekee kaikkea huonosti; se tarkoittaa, että näkee
          enemmän kuin sen, mitä oman tontin rajalta näkyy.
        </p>
      </Fragment>
      <Fragment slot="column2">
        <img
          src="/images/omakuva.jpg"
          alt="Christa Eloranta"
          class="rounded-md md:max-w-120 mx-auto aspect-square object-cover overflow-hidden object-[75%_100%] reveal shadow-md"
        />
      </Fragment>
    </TwoColumns>

    <div
      class="flex flex-col w-full max-w-4xl mx-auto gap-8 items-start justify-center"
    >
      <h2
        class="text-3xl font-serif-secondary italic mt-12 ml-0 reveal max-w-2xl"
      >
        Uniikki yhdistelmä erilaista osaamista, <span
          class="text-brand-highlight">kykyä nähdä asiat monesta kulmasta</span
        > sekä resilienssiä kohdata muutoksia
      </h2>
      <p class="mb-8 reveal font-sans-secondary">
        Rönsyilevältä näyttävä polku kertoo kroonisesta uteliaisuudesta,
        monipuolisuudesta, kyvystä innostua herkästi sekä uskalluksesta
        heittäytyä.
      </p>

      <TimelineAccordion>
        <TimelineAccordionItem
          period="2022 - aktiivinen"
          icon="worker-in-front-of-a-computer-monitor-svgrepo-com"
          title="Web-kehittäjä"
          highlights={{
            arkkitehtuurit: "technical",
            tuotteistaminen: "design",
            kommunikaatio: "soft",
          }}
        >
          <p>
            summary="Rakensin tapaa ajatella tuotteita sekä visuaalisina että
            toiminnallisina kokonaisuuksina." Muotoilu ja käsityö opettivat
            katsomaan kokonaisuutta: materiaalia, mittakaavaa, rytmiä ja
            yksityiskohtia. Samaa ajattelua vien nykyään myös digitaalisiin
            tuotteisiin.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2022 - 2025"
          icon="graduate-cap-svgrepo-com"
          title="Tieto- ja viestintätekniikan insinööri (AMK)"
          highlights={{
            ohjelmointi: "technical",
            systemaattisuus: "metaskill",
            omaksumiskyky: "metaskill",
          }}
        >
          <p>
            Syvennyin web-kehitykseen, TypeScriptiin ja käytännön
            integraatiototeutuksiin. Tänä vuonna olen tehnyt eniten töitä
            web-puolella: rakennellut käyttöliittymiä, yhdistänyt järjestelmiä
            toisiinsa ja pitänyt huolta siitä, että ratkaisut pysyvät selkeinä
            sekä käyttäjälle että ylläpitäjälle.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2020 - 2022"
          icon="graduate-cap-svgrepo-com"
          title="Hienopuuseppä"
          highlights={{
            materiaalituntemus: "technical",
            tarkkuus: "metaskill",
            pitkäjänteisyys: "metaskill",
          }}
        >
          <p>
            summary="Rakensin tapaa ajatella tuotteita sekä visuaalisina että
            toiminnallisina kokonaisuuksina." Muotoilu ja käsityö opettivat
            katsomaan kokonaisuutta: materiaalia, mittakaavaa, rytmiä ja
            yksityiskohtia. Samaa ajattelua vien nykyään myös digitaalisiin
            tuotteisiin.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2019 - aktiivinen"
          icon="productivity-ability-talent-productive-svgrepo-com"
          title="Tmi Christa Eloranta"
          highlights={{
            konseptointi: "design",
            projektinhallinta: "soft",
            itseohjautuvuus: "metaskill",
          }}
        >
          <p>
            summary="Asiakaspalvelu ja nopeat tilanteet opettivat lukemaan
            ihmisiä ja tekemään päätöksiä paineessa." Ravintolatyö oli hyvä
            koulu siihen, miten ihmiset oikeasti toimivat. Se opetti
            joustavuutta, palveluasennetta ja tilanteiden lukemista.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2016 - 2019"
          icon="graduate-certificate-svgrepo-com"
          title="Taiteen kandidaatti"
          summary="Tieto- ja viestintätekniikan opinnot toivat rakenteen, työkalut ja teknisen selkänojan."
          highlights={{
            käyttäjäymmärrys: "design",
            visuaalisuus: "design",
            hahmottamiskyky: "metaskill",
          }}
        >
          <p>
            Opinnot toivat ohjelmointiin rakenteen ja työskentelyyn enemmän
            varmuutta. Samalla vahvistui ajatus siitä, että teknisyys ja
            visuaalisuus voivat tukea toisiaan.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2009 - 2019"
          icon="cocktails-cocktail-svgrepo-com"
          title="Ura ravintola-alalla"
          highlights={{
            paineensietokyky: "metaskill",
            tiimityö: "soft",
            asiakaskohtaaminen: "soft",
          }}
        >
          <p>
            summary="Asiakaspalvelu ja nopeat tilanteet opettivat lukemaan
            ihmisiä ja tekemään päätöksiä paineessa." Ravintolatyö oli hyvä
            koulu siihen, miten ihmiset oikeasti toimivat. Se opetti
            joustavuutta, palveluasennetta ja tilanteiden lukemista.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2015 - 2016"
          icon="graduate-cap-svgrepo-com"
          title="Sisustaja"
          highlights={{
            tilasuunnittelu: "design",
            toteutus: "technical",
            tarkkuus: "metaskill",
          }}
        >
          <p>
            summary="Asiakaspalvelu ja nopeat tilanteet opettivat lukemaan
            ihmisiä ja tekemään päätöksiä paineessa." Ravintolatyö oli hyvä
            koulu siihen, miten ihmiset oikeasti toimivat. Se opetti
            joustavuutta, palveluasennetta ja tilanteiden lukemista.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2012 - 2013"
          icon="graduate-cap-svgrepo-com"
          title="Baarimestari"
          highlights={{
            johtaminen: "soft",
            laadunvalvonta: "technical",
            konseptointi: "design",
          }}
        >
          <p>
            summary="Asiakaspalvelu ja nopeat tilanteet opettivat lukemaan
            ihmisiä ja tekemään päätöksiä paineessa." Ravintolatyö oli hyvä
            koulu siihen, miten ihmiset oikeasti toimivat. Se opetti
            joustavuutta, palveluasennetta ja tilanteiden lukemista.
          </p>
        </TimelineAccordionItem>
      </TimelineAccordion>
    </div>

    <TwoColumns
      column1Class="bg-brand text-surface-primary rounded-md md:p-8 p-4 shadow-md"
      column2Class="bg-brand-highlight text-surface-primary rounded-md md:p-8 p-4 shadow-md"
      reveal
    >
      <Fragment slot="column1">
        <Icon
          name="productivity-ability-talent-productive-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic mb-4">
          Tarviiko olla erityisosaaja ollakseen uskottava?
        </h2>
        <p>
          Ei tarvitse. Uskon, että jokaisella on oikeus ilmaista itseään ja
          luoda asioita, jotka heijastavat heidän intohimojaan ja kiinnostuksen
          kohteitaan, riippumatta siitä, onko heillä muodollista koulutusta tai
          erityisosaamista tietyllä alueella. Olen itse esimerkki siitä, että
          voit olla monipuolinen ja luova ilman, että sinun tarvitsee olla
          asiantuntija kaikilla aloilla. Tärkeintä on olla avoin oppimaan ja
          kokeilemaan uusia asioita, ja olla valmis jakamaan luomuksesi muiden
          kanssa.
        </p>
      </Fragment>
      <Fragment slot="column2">
        <Icon
          name="multi-ring-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic mb-4">
          Jotain generalismin hyödyistä
        </h2>
        <p>
          Generalismi voi tarjota laajemman näkökulman ja kyvyn yhdistää eri
          alojen tietoa ja taitoja. Tämä voi johtaa innovatiivisiin ratkaisuihin
          ja luoviin ideoihin, joita erikoistunut asiantuntija ei välttämättä
          huomaisi. Generalisti voi myös sopeutua nopeasti muuttuviin
          tilanteisiin ja oppia uusia taitoja tarpeen mukaan, mikä tekee heistä
          joustavia ja monipuolisia tiimin jäseniä.
        </p>
      </Fragment>
    </TwoColumns>
  </Content>
</MainLayout>
