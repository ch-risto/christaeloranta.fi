---
import Content from "../components/layout/Content.astro";
import Hero from "../components/ui/Hero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import TimelineAccordion from "../components/ui/TimelineAccordion.astro";
import TimelineAccordionItem from "../components/ui/TimelineAccordionItem.astro";

import { Icon } from "astro-icon/components";
import Tag from "../components/ui/Tag.astro";
import TwoColumns from "../components/ui/TwoColumns.astro";
---

<MainLayout title="Minusta">
  <Hero
    imageUrl="lonkeroraportti2.svg"
    imageClass="md:bg-[length:65%] bg-[length:100%]"
  >
    <Fragment slot="tags">
      <Tag additionalClass="reveal">monipuolinen</Tag>
      <Tag additionalClass="reveal">luova</Tag>
      <Tag additionalClass="reveal">utelias</Tag>
    </Fragment>
    <Fragment slot="title"
      ><span class="text-brand-highlight italic">Christa</span><br
      />Eloranta</Fragment
    >
    <Fragment slot="description">
      Tieto- ja viestintätekniikan insinööri, taiteen kandidaatti, puuseppä,
      sisustaja, baarimestari, koodari, käsityöläinen, suunnittelija,
      juonittelija, generalisti, tuuliviiri
    </Fragment>
  </Hero>
  <Content>
    <TwoColumns
      containerClass="bg-surface-secondary md:p-8 p-4 rounded-sm"
      column1Class="order-2 md:order-1 bg-surface-primary md:p-8 p-4 shadow-md rounded-sm !md:w-full"
      column2Class="order-1 md:order-2 justify-center !md:w-fit"
      reveal
    >
      <Fragment slot="column1">
        <h2 class="text-3xl font-serif-secondary italic mb-4">Meitsi</h2>
        <p>
          Olen utelias ja muutoksella käyvä tuuliviiri. En kulje väkisin
          vastatuuleen, vaan minulle on luontevaa vaihtaa suuntaa tarvittaessa.
          Kirjava tausta ei johdu määrätietoisuuden puutteesta vaan on merkki
          laaja-alaisesta kiinnostuksesta ja tapa kerätä osaamisista
          kokonaisuus, jota harvalla on.
        </p>
        <p class="pt-4">
          Taustani on yökerho- ja karaokemaailmassa, minkä ansiosta
          asiakaslähtöisyys on oletusasetus tekemisessäni, enkä hätkähdä
          erikoisia ja muuttuvia tilanteita. Muotoiluopinnoissa olen saanut
          vahvan pohjan käyttäjälähtöiselle suunnittelulle ja hienopuusepäksi
          opiskellessani silmäni yksityiskohdille vahvistui entisestään.
          Koodarina olen oppinut ratkaisemaan ongelmia loogisesti ja tehokkaasti
          ja luomaan tuotteista toimivia.
        </p>
        <p class="pt-4">
          Ohjelmistoala elää jatkuvassa muutoksessa — ja siinä laaja-alaisuus on
          oikeasti kilpailuetu, ei kompromissi. Monipuolinen osaaminen ei
          tarkoita, että tekee kaikkea huonosti; se tarkoittaa, että näkee
          enemmän kuin sen, mitä oman tontin rajalta näkyy.
        </p>
      </Fragment>
      <Fragment slot="column2">
        <img
          src="/images/omakuva.jpg"
          alt="Christa Eloranta"
          class="rounded-md md:max-w-120 mx-auto aspect-square object-cover overflow-hidden object-[75%_100%] reveal shadow-md"
        />
      </Fragment>
    </TwoColumns>

    <div
      class="flex flex-col w-full max-w-4xl mx-auto gap-6 items-start justify-center"
    >
      <h2 class="text-3xl font-serif-secondary italic ml-0 reveal max-w-2xl">
        Uniikki yhdistelmä erilaista osaamista, <span
          class="text-brand-highlight">kykyä nähdä asiat monesta kulmasta</span
        > sekä resilienssiä kohdata muutoksia
      </h2>
      <p
        class="max-w-2xl mb-8 reveal font-sans-secondary text-content-tertiary tracking-tight leading-6 md:leading-7"
      >
        Rönsyilevältä näyttävä polku kertoo kroonisesta uteliaisuudesta,
        monipuolisuudesta, kyvystä innostua herkästi sekä uskalluksesta
        heittäytyä. Yhdistävänä tekijänä ratkaisujen kehittäminen,
        luomisprosessit ja se, miten asiat siirtyvät ideasta käyttäjälle.
      </p>

      <TimelineAccordion>
        <TimelineAccordionItem
          period="2022 - aktiivinen"
          icon="worker-in-front-of-a-computer-monitor-svgrepo-com"
          title="Web-kehittäjä"
          highlights={{
            arkkitehtuurit: "technical",
            tuotteistaminen: "design",
            kommunikaatio: "soft",
          }}
        >
          <p>
            Ohjelmistokehittäjänä tamperelaisess ratkaisutalossa pääsen
            päivittäin yhdistelemään erilaisia puolia osaamisestani. Roolissani
            toimin siltana teknologian ja käyttäjän välillä rakentaessani
            käytettäviä ja saavutettavia verkkosivuja. Olen päässyt syventymään
            monipuolisesti erilaisiin teknologioihin, kehittämään
            varastointegraatioita, modernisoimaan SSO-järjestelmän ja
            tuotteistamaa yrityksen palveluita..
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2022 - 2025"
          icon="graduate-cap-svgrepo-com"
          title="Tieto- ja viestintätekniikan insinööri (AMK)"
          highlights={{
            ohjelmointi: "technical",
            systemaattisuus: "metaskill",
            omaksumiskyky: "metaskill",
          }}
        >
          <p>
            Opinnot Lapin AMK:ssa antoivat vahvan pohjan ohjelmointiin,
            tietokantoihin ja ohjelmistoarkkitehtuureihin. Insinöörin ja
            muotoilijan tehtävät eivät käytännössä juurikaan eroa toisistaan,
            työkalut ja painotukset vaan ovat erilaisia. Kummankin tavoitteena
            on kuitenkin ratkaista ongelmia ja luoda helppokäyttöisiä ja toimia
            kokonaisuuksia.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2020 - 2022"
          icon="graduate-cap-svgrepo-com"
          title="Hienopuuseppä"
          highlights={{
            materiaalituntemus: "technical",
            tarkkuus: "metaskill",
            pitkäjänteisyys: "metaskill",
          }}
        >
          <p>
            Mikään ei synny tyhjiössä, vaan luodakseen toimivia ja visuaalisesti
            houkuttelevia tuotteita, on tunnettava myös materiaalit. Aiemmissa
            sisustajan opinnoissani olin päässyt raapaisemaan pintaa puun
            työskentelyn kanssa ja halusin syventää osaamistani kovista
            materiaaleista. Hienopuuseppäopinnot olivat luonteva valinta
            muotoiluopinnoissa kerrytetyn osaamisen syventämiseksi.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2019 - aktiivinen"
          icon="productivity-ability-talent-productive-svgrepo-com"
          title="Tmi Christa Eloranta"
          highlights={{
            konseptointi: "design",
            projektinhallinta: "soft",
            itseohjautuvuus: "metaskill",
          }}
        >
          <p>
            Olen työntekijänäkin yrittäjähenkinen, joten toiminimiyrittäjyys on
            ollut vain ajan kysymys. Puuseppäopintojen ohessa suunnittelin ja
            toteutin tilaustöitä ja erilaisia pientuotteita. Olen myös tehnyt
            sisustusremontointia, ikkunoiden kunnostusta, festivaalialueen
            aluevalaistuksen toteuttamista ja verkkokauppamyyntiä. Verkkokauppaa
            uudistetaan tällä hetkellä.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2016 - 2019"
          icon="graduate-cap-svgrepo-com"
          title="Taiteen kandidaatti"
          highlights={{
            käyttäjäymmärrys: "design",
            visuaalisuus: "design",
            hahmottamiskyky: "metaskill",
          }}
        >
          <p>
            Sisustus- ja tekstiilimuotoilun opinnot Lapin yliopistossa antoivat
            valtavasti ymmärrystä ja käytännön osaamista käyttäjälähtöisestä
            suunnittelusta, konseptiajattelusta sekä erilaisista
            muotoiluprosesseista. Pääaineeni keskittyi tilalliseen suunnitteluun
            ja pehmeisiin materiaaleihin, ja sivuaineena lukemani teollinen
            muotoilu puolestaan keskittyi tuote- ja palvelumuotoiluun.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2009 - 2019"
          icon="cocktails-cocktail-svgrepo-com"
          title="Ura ravintola-alalla"
          highlights={{
            paineensietokyky: "metaskill",
            tiimityö: "soft",
            asiakaskohtaaminen: "soft",
          }}
        >
          <p>
            Kymmenen vuotta ravintola-alalla opetti selviytymään nopeasti
            muuttuvissa tilanteissa lähes missä tahansa ympäristössä kenen
            tahansa kanssa. Usein sanotaan, että jokaisen pitäisi kokeilla
            asiakaspalvelutyötä, ja olen siitä ehdottomasti samaa mieltä. Paitsi
            että se opettaa ymmärtämään ihmisiä, tunnistamaan erilaisia
            tarpeita, myös lukemaan erilaisia tilanteita ja kohtaamaan ne
            joustavasti ja ammattimaisesti. Puhumattakaan työmoraalista ja
            hands-on -asenteesta.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2015 - 2016"
          icon="graduate-cap-svgrepo-com"
          title="Sisustaja"
          highlights={{
            tilasuunnittelu: "design",
            toteutus: "technical",
            huolellisuus: "metaskill",
          }}
        >
          <p>
            Olen aina ollut enemmän tekevä ihminen ja kun päätin lähteä
            vaihtamaan alaa pois ravintola-alalta Sisustajan ammattiopinnot
            tuntuivat mielenkiintoiselta askeleelta kohti itseni näköistä
            tekemistä. Opinnoissa pääsi kokeilemaan huonekalurakentamista,
            sisustusremontointia ja -suunnittelua sekä verhoilua. Opintojen
            ohella kävin viikonloppuisin muunmuassa tekemässä koristemaalauksia
            vanhan maalaistalon kattoon, kunnostamassa ikkunoita tai maalaamassa
            navettoja maitotilalla.
          </p>
        </TimelineAccordionItem>

        <TimelineAccordionItem
          period="2012 - 2013"
          icon="graduate-cap-svgrepo-com"
          title="Baarimestari"
          highlights={{
            johtaminen: "soft",
            laadunvalvonta: "technical",
            konseptointi: "design",
          }}
        >
          <p>
            Baarimestarin erikoisammattitutkinnon suoritin töiden ohella
            oppisopimuksella. Koulutukseen kuului miksologian ja
            tuotetuntemuksen lisäksi johtamiseen, asiakaspalveluun ja
            laadunvalvontaan liittyviä opintoja. Koulutus valmistaa toimimaan
            esihenkilötehtävissä, ja se antoi hyvän pohjan ymmärtää
            ravintolaliiketoimintaa, mistä on ollut hyötyä myös yrittäjyydessäni
            ja siirtyessäni muille aloille.
          </p>
        </TimelineAccordionItem>
      </TimelineAccordion>
    </div>

    <TwoColumns
      column1Class="bg-brand text-surface-primary rounded-md md:p-8 p-4 shadow-md"
      column2Class="bg-brand-highlight text-surface-primary rounded-md md:p-8 p-4 shadow-md"
      reveal
    >
      <Fragment slot="column1">
        <Icon
          name="multi-directions-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic mb-4">
          Moniosaajan osaamisprofiili
        </h2>
        <p>
          T-mallin osaajalla on yksi syvä erikoisosaaminen ja laaja
          yleisymmärrys muusta. Kampamaisessa profiilissa syväosaamista on
          usealta eri alalta ja lisäksi laaja yleisymmärrys muusta. En tiedä,
          voisiko moniosaajan osaamisprofiili olla verkkomainen. Mitä useampaan
          aiheeseen olen päässyt syventymään, sitä enemmän yhteneväisyyksiä näen
          eri alojen välillä. Yksittäinen "palkki" ei välttämättä ole yhtä syvä,
          kuin asiantuntijalla, joka keskittyy vain yhteen asiaan, mutta
          moniosaajan arvo piileekin asioiden yhdistelyssä. Kokonaisuuksien
          hahmottaminen vaatii monipuolisuutta ja laatikoiden välillä
          seikkailua. Juuri sitä, mitä moniosaaja, multipotentialite,
          generalisti, renessanssi-ihminen,
          <span class="font-serif-secondary bold">tuuliviiri</span> - rakkaalla lapsella
          on monta nimeä - tarjoaa.
        </p>
      </Fragment>
      <Fragment slot="column2">
        <Icon
          name="multi-ring-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic mb-4">
          Generalisti ei sovi kaikkiin organisaatioihin
        </h2>
        <p>
          Jos organisaatiossa ei ole mahdollisuutta kehittyä, vaikuttaa asioihin
          tai hyödyntää laaja-alaisuutta, moniosaaja on todennäköisesti se
          ärsyttävä tyyppi, joka nostaa esiin epäkohtia, ei pysy omalla
          tontillaan ja lopulta turhautuu ja lähtee. Moniosaaja kaipaa
          vaihtelua, eivätkä loputtomat murmelinpäivät ole meitä varten.
          Moniosaajat oppivat nopeasti ja ovat sopeutumiskykyisiä. Jos
          organisaatio siis haluaa ihmisen, joka omaksuu vain sen yhden, jo 35
          vuotta toimineen tavan tehdä asioita, eikä kyseenalaista tai kehitä
          prosesseja, ei moniosaaja ole oikea valinta. Mutta jos organisaatio
          haluaa ketterän, uteliaan ja monipuolisen tekijän, joka näkee asioita
          laaja-alaisesti, saattaa moniosaaja olla juuri se, jota kannattaa
          hakea.
        </p>
      </Fragment>
    </TwoColumns>
  </Content>
</MainLayout>
