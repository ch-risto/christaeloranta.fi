---
import Hero from "../components/ui/Hero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/form/ContactForm.astro";
import Content from "../components/layout/Content.astro";
import Tag from "../components/ui/Tag.astro";
import Button from "../components/ui/Button.astro";

import { Icon } from "astro-icon/components";
---

<!-- Etusivu - / -->
<MainLayout title="Etusivu" headerColor="transparent">
  <Hero imageUrl="routa_pattern_yellow.svg" type="main">
    <Fragment slot="tags">
      <Tag>ohjelmistokehitys</Tag>
      <Tag>design</Tag>
      <Tag>käsityöt</Tag>
    </Fragment>
    <Fragment slot="title"
      >Jonkin sortin <span class="text-brand-highlight italic">Tuuliviiri</span
      ></Fragment
    >
    <Fragment slot="description">
      Monipuolisuus ja laatikoiden ulkopuolella viihtyminen (ja toisaalta vähän
      jokaiseen laatikkoon sopiminen) luovat pohjan toimiville, ihmisille
      tehdyille ratkaisuille.</Fragment
    >
    <Fragment slot="additional-content">
      <div class="flex flex-row gap-2">
        <Button variant="primary" href="#contact-form">Ota yhteyttä</Button>
        <Button variant="secondary" href="https://archive.christaeloranta.fi">
          Kurkkaa arkistoitu verkkosivu
        </Button>
      </div>
    </Fragment>
  </Hero>
  <Content>
    <div
      class="flex md:flex-row flex-col w-full max-w-6xl mx-auto gap-8 items-center justify-center bg-surface-secondary p-4"
    >
      <div
        class="max-w-lg justify-center mx-auto bg-surface-primary/80 rounded-lg md:p-8 p-4 shadow-md order-2 md:order-1"
      >
        <h2 class="text-3xl font-serif italic mb-4 reveal">
          Full-stack developer, designer & maker
        </h2>
        <p class="text-content-primary reveal">
          <span class="font-serif-secondary text-2xl pr-1 text-brand-highlight"
            >Moikka!</span
          > Olen Christa Eloranta, monipuolinen tekijä, joka nauttii konkreettisesta
          tekemisestä. Parhaimmillani olen idean ja tuotteen rajapinnassa, ratkaisemassa
          sitä, miten visiot tuodaan konkreettisiksi, toimiviksi ja kauniiksi kokonaisuuksiksi.
        </p>
        <p class="font-serif-secondary text-xl reveal pt-4">
          Toimivimmat ratkaisut syntyvät yhdistämällä monipuolisesti erilaisia
          näkökulmia ja tapoja tehdä.
        </p>
        <div class="flex flex-col justify-start items-start mt-4">
          <Button variant="textLink" href="/Eloranta-CV.pdf" target="_blank">
            <Icon name="file-cv-svgrepo-com" />CV</Button
          >
          <Button
            variant="textLink"
            href="https://www.linkedin.com/in/christa-eloranta/"
            ><Icon name="linkedin-161-svgrepo-com" />LinkedIn</Button
          >
          <Button
            variant="textLink"
            href="https://www.instagram.com/christaeloranta/"
            ><Icon name="instagram-svgrepo-com" />Instagram</Button
          >
          <Button variant="textLink" href="https://github.com/ch-risto"
            ><Icon name="github-142-svgrepo-com" />GitHub</Button
          >
        </div>
      </div>
      <div class="justify-center md:mx-auto order-1 md:order-2">
        <img
          src="/images/ChristaEloranta.jpg"
          alt="Christa Eloranta, monipuolinen tekijä"
          class="rounded-full md:max-w-120 max-w-70 aspect-square object-cover overflow-hidden object-[100%_25%] m-4 reveal shadow-md"
        />
      </div>
    </div>
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-8 reveal-group"
    >
      <div class="bg-brand p-8 rounded-2xl text-surface-primary reveal">
        <Icon
          name="code-tech-dev-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2
          class="text-2xl font-serif-secondary bold text-heading-primary mb-4"
        >
          Ohjelmistokehitys
        </h2>
        <p class="max-w-lg">
          Olen tieto- ja viestintätekniikan AMK insinööri, olen toiminut nyt
          kaksi vuotta web-kehityksen ja erilaisten integraatiototeutusten
          parissa. Tekemisessäni yhdistyy insinöörimäinen systemaattisuus ja
          muotoilijalähtöinen luovuus.
        </p>
        <p class="max-w-lg pt-4">
          Olen työskennellyt monipuolisesti eri teknologioiden parissa, kuten
          Python, TypeScript, React, Node.js, konttipohjaiset ympäristöt
          (Docker) ja pilvialustat (GCP). Käytän tekoälytyökaluja luontevasti ja
          kroonisesti uteliaana kehitän jatkuvasti osaamistani.
        </p>
      </div>
      <div class="p-4 reveal">
        <Icon
          name="design-ideas-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
          Design
        </h2>
        <p class="text-content-primary max-w-lg">
          Olen opiskellut muotoilua Lapin yliopistossa ja sieltä karttui paitsi
          visuaalista osaamista ja kädentaitoja, myös ymmärrystä erilaisista
          muotoiluprosesseista ja -työkaluista. Käyttäjälähtöinen
          ongelmanratkaisu ja käytettävyyden huomioiminen kaikessa tekemisessä
          on minulle tärkeintä. Jos asioita: tuotteita, ratkaisuja tai
          esityksiä, ei tehtäisi käyttäjälle, ei niitä tarvitsisi tehdä
          lainkaan.
        </p>
      </div>
      <div
        class="bg-brand-highlight p-8 rounded-2xl text-surface-primary reveal"
      >
        <Icon
          name="carpentry-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
          Tilaustyöt
        </h2>
        <p class="max-w-lg">
          Käsityöt ovat minulle intohimo, joten olen päätynyt myös opiskelemaan
          luovia aloja. Olen taiteen kandidaatti pääaineena sisustus- ja
          tekstiilimuotoilu, olen opiskellut itseni myös hienopuusepäksi sekä
          minulla on sisustajan osatutkinto.
        </p>
        <p class="max-w-lg pt-4">
          Verkkokauppa on vielä kehitysvaiheessa, mutta tekemisiäni pääset
          kurkkaamaan
          <Button
            variant="textLink"
            class="text-surface-primary hover:text-surface-primary! inline-flex underline p-0 md:p-0"
            href="https://www.instagram.com/christaeloranta/"
            ><Icon name="instagram-svgrepo-com" />Instagramista</Button
          > tai <Button
            variant="textLink"
            class="text-surface-primary hover:text-surface-primary! inline-flex underline p-0 md:p-0"
            href="https://archive.christaeloranta.fi"
            target="_blank">arkistoidulta verkkosivultani</Button
          >.
        </p>
      </div>
    </div>
  </Content>
  <Content color="secondary">
    <ContactForm />
  </Content>
</MainLayout>
