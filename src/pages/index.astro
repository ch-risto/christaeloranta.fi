---
import Hero from "../components/ui/Hero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/form/ContactForm.astro";
import Content from "../components/layout/Content.astro";
import Tag from "../components/ui/Tag.astro";
import Button from "../components/ui/Button.astro";

import { Icon } from "astro-icon/components";
---

<!-- Etusivu - / -->
<MainLayout title="Etusivu" headerColor="transparent">
  <Hero imageUrl="routa_pattern_yellow.svg" type="main">
    <Fragment slot="tags">
      <Tag>ohjelmistokehitys</Tag>
      <Tag>design</Tag>
      <Tag>käsityöt</Tag>
    </Fragment>
    <Fragment slot="title"
      >Jonkin sortin <span class="text-brand-highlight italic">Tuuliviiri</span
      ></Fragment
    >
    <Fragment slot="description">
      Monipuolisuus ja laatikoiden ulkopuolella pysyminen - ja toisaalta vähän
      jokaisessa laatikossa viihtyminen - luovat pohjan toimiville, ihmisille
      tehdyille, ratkaisuille. Ite kun tekee, tulee mitä huvittaa tehdä.</Fragment
    >
    <Fragment slot="additional-content">
      <div class="flex flex-row gap-2">
        <Button variant="primary" href="#contact-form">Ota yhteyttä</Button>
        <Button variant="secondary" href="https://archive.christaeloranta.fi">
          Kurkkaa arkistoitu verkkosivu
        </Button>
      </div>
    </Fragment>
  </Hero>
  <Content>
    <div
      class="flex md:flex-row flex-col w-full max-w-6xl mx-auto gap-8 items-center justify-center bg-surface-secondary md:p-0 p-4"
    >
      <div
        class="max-w-lg justify-center mx-auto bg-surface-primary/80 rounded-lg md:p-8 p-4 shadow-md order-2 md:order-1"
      >
        <h2 class="text-3xl font-serif italic mb-4 reveal">
          Monipuolinen osaaja
        </h2>
        <p class="text-content-primary reveal">
          Moikka! Olen Christa Eloranta, monipuolinen tekijä, joka nauttii
          asioiden toteuttamisesta. Parhaimmillani olen idean ja toteutuksen
          rajapinnassa, ratkaisemassa sitä, miten visiot tuodaan
          konkreettisiksi, toimiviksi ja kauniiksi kokonaisuuksiksi. Uskon, että
          monipuolisuus tekemisessä ja osaamisessa luo ainutlaatuisia,
          innovatiivisia ja toimivia ratkaisuja, jotka erottuvat joukosta.
        </p>
        <div class="flex flex-col justify-start items-start mt-4">
          <Button variant="textLink" href="/Eloranta-CV.pdf" target="_blank">
            <Icon name="file-cv-svgrepo-com" />CV</Button
          >
          <Button
            variant="textLink"
            href="https://www.linkedin.com/in/christa-eloranta/"
            ><Icon name="linkedin-161-svgrepo-com" />LinkedIn</Button
          >
          <Button
            variant="textLink"
            href="https://www.instagram.com/christaeloranta/"
            ><Icon name="instagram-svgrepo-com" />Instagram</Button
          >
          <Button variant="textLink" href="https://github.com/ch-risto"
            ><Icon name="github-142-svgrepo-com" />GitHub</Button
          >
        </div>
      </div>
      <div class="justify-center md:mx-auto order-1 md:order-2">
        <img
          src="/images/ChristaEloranta.jpg"
          alt="Christa Eloranta, monipuolinen tekijä"
          class="rounded-full md:max-w-120 max-w-70 aspect-square object-cover overflow-hidden object-[100%_25%] m-4 reveal shadow-md"
        />
      </div>
    </div>
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-8 reveal-group"
    >
      <div class="bg-brand p-8 rounded-2xl text-surface-primary reveal">
        <Icon
          name="code-tech-dev-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2
          class="text-2xl font-serif-secondary bold text-heading-primary mb-4"
        >
          Ohjelmistokehitys
        </h2>
        <p class="max-w-lg">
          Tarjoamme räätälöityjä ohjelmistoratkaisuja, jotka on suunniteltu
          vastaamaan asiakkaidemme ainutlaatuisia tarpeita. Olipa kyseessä
          verkkosovellus, mobiilisovellus tai räätälöity ohjelmisto, meillä on
          osaaminen ja kokemus toteuttaa ratkaisu, joka tehostaa
          liiketoimintaasi ja parantaa käyttäjäkokemusta.
        </p>
      </div>
      <div class="p-4 reveal">
        <Icon
          name="design-ideas-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
          Design
        </h2>
        <p class="text-content-primary max-w-lg">
          Taiteen kandidaatti, joka on erikoistunut luomaan visuaalisesti
          houkuttelevia ja toimivia suunnitteluratkaisuja. Minulla on vahva
          tausta graafisessa suunnittelussa, käyttöliittymäsuunnittelussa ja
          brändäyksessä, ja olen sitoutunut tuottamaan korkealaatuista työtä,
          joka ylittää asiakkaiden odotukset. Olen taitava käyttämään erilaisia
          suunnittelutyökaluja ja ohjelmistoja, ja minulla on kyky ymmärtää
          asiakkaiden tarpeita ja muuttaa ne tehokkaiksi
          suunnitteluratkaisuiksi, jotka parantavat heidän liiketoimintaansa ja
          vahvistavat heidän brändiään.
        </p>
      </div>
      <div
        class="bg-brand-highlight p-8 rounded-2xl text-surface-primary reveal"
      >
        <Icon
          name="carpentry-svgrepo-com"
          class="md:h10 h-8 md:w-10 w-8 mb-4"
        />
        <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
          Käsityöt
        </h2>
        <p class="max-w-lg">
          Käsityöt ovat minulle intohimo, ja nautin luovasta prosessista, joka
          liittyy erilaisten esineiden ja taideteosten luomiseen. Minulla on
          laaja kokemus erilaisista käsityötekniikoista, kuten puuntyöstö,
          keramiikka ja tekstiilityöt, ja olen aina innokas oppimaan uusia
          taitoja ja kokeilemaan uusia materiaaleja. Uskon, että käsityöt eivät
          ole vain tapa ilmaista luovuutta, vaan myös keino luoda yhteys
          perinteisiin ja kulttuuriperintöön, ja olen sitoutunut tuottamaan
          korkealaatuista työtä, joka heijastaa tätä filosofiaa.
        </p>
      </div>
    </div>
  </Content>
  <Content color="secondary">
    <ContactForm />
  </Content>
</MainLayout>
