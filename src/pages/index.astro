---
import Hero from "../components/ui/Hero.astro";
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/form/ContactForm.astro";
import Content from "../components/layout/Content.astro";
import Tag from "../components/ui/Tag.astro";
import Button from "../components/ui/Button.astro";
import Accordion from "../components/ui/Accordion.astro";
import AccordionItem from "../components/ui/AccordionItem.astro";

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import christa from "../assets/images/ChristaEloranta.jpg";
---

<!-- Etusivu - / -->
<MainLayout
  title="Christa Eloranta | Full-stack kehittäjä, designer & tekijä"
  description="Tieto- ja viestintätekniikan insinööri, taiteen kandidaatti, puuseppä,  sisustaja, baarimestari, koodari, käsityöläinen, suunnittelija, juonittelija, generalisti"
  headerColor="transparent"
>
  <Hero imageUrl="images/routa_pattern.svg" type="main">
    <Fragment slot="tags">
      <Tag additionalClass="reveal">ohjelmistokehitys</Tag>
      <Tag additionalClass="reveal">design</Tag>
      <Tag additionalClass="reveal">käsityöt</Tag>
    </Fragment>
    <Fragment slot="title"
      >Jonkin sortin <span class="text-brand-highlight italic">Tuuliviiri</span
      ></Fragment
    >
    <Fragment slot="description">
      Monipuolisuus ja laatikoiden ulkopuolella viihtyminen (ja toisaalta vähän
      jokaiseen laatikkoon sopiminen) luovat pohjan toimiville, ihmisille
      tehdyille ratkaisuille</Fragment
    >
    <Fragment slot="additional-content">
      <div class="flex flex-row gap-2">
        <Button variant="primary" href="#contact-form">Ota yhteyttä</Button>
      </div>
    </Fragment>
  </Hero>
  <Content>
    <div
      class="flex md:flex-row flex-col w-full max-w-6xl mx-auto gap-8 items-center justify-center bg-surface-secondary p-4"
    >
      <div
        class="max-w-lg justify-center mx-auto bg-surface-primary/80 rounded-lg md:p-8 p-4 shadow-md order-2 md:order-1"
      >
        <h2 class="text-3xl font-serif italic mb-4 reveal">
          Full-stack developer, designer & maker
        </h2>
        <p class="text-content-primary reveal">
          <span class="font-serif-secondary text-2xl pr-1 text-brand-highlight"
            >Moikka!</span
          > Olen Christa Eloranta, monipuolinen tekijä, utelias kyseenalaistaja ja
          rajapintoja yhdistelevä generalisti. Parhaimmillani olen siltana idean ja
          tuotteen välissä, ratkaisemassa sitä, miten visiot tuodaan konkreettisiksi,
          toimiviksi ja kauniiksi kokonaisuuksiksi.
        </p>
        <p class="font-serif-secondary text-xl reveal pt-4">
          Toimivimmat ratkaisut syntyvät yhdistämällä monipuolisesti erilaisia
          näkökulmia ja tapoja tehdä.
        </p>
        <div class="flex flex-col justify-start items-start mt-4">
          class="rounded-full md:max-w-120 max-w-70 aspect-square object-cover
          overflow-hidden object-[100%_25%] m-4 shadow-md"
          <Icon name="file-cv-svgrepo-com" />CV
        </div>
        <Button
          variant="textLink"
          href="https://www.linkedin.com/in/christa-eloranta/"
          ><Icon name="linkedin-161-svgrepo-com" />LinkedIn</Button
        >
        <Button
          variant="textLink"
          href="https://www.instagram.com/christaeloranta/"
          ><Icon name="instagram-svgrepo-com" />Instagram</Button
        >
        <Button variant="textLink" href="https://github.com/ch-risto"
          ><Icon name="github-142-svgrepo-com" />GitHub</Button
        >
      </div>
    </div>
    <div class="justify-center md:mx-auto order-1 md:order-2">
      <Image
        src={christa}
        alt="Christa Eloranta, monipuolinen tekijä"
        class="rounded-full md:max-w-120 max-w-70 aspect-square object-cover overflow-hidden object-[100%_25%] m-4 reveal shadow-md"
      />
    </div>
  </Content>
  <div
    class="flex flex-col md:flex-row items-center justify-center gap-8 reveal-group max-w-6xl mx-auto w-full"
  >
    <div class="bg-brand p-8 rounded-2xl text-surface-primary reveal">
      <Icon
        name="code-tech-dev-svgrepo-com"
        class="md:h10 h-8 md:w-10 w-8 mb-4"
      />
      <h2 class="text-2xl font-serif-secondary bold text-heading-primary mb-4">
        Ohjelmistokehitys
      </h2>
      <p class="max-w-lg">
        Näen ohjelmistokehityksen kokonaisvaltaisena ongelmanratkaisuna, jossa
        koodi on vain työkalu lopputuloksen saavuttamiseksi. Hyvä ratkaisu on
        paitsi saavutettava ja helppokäyttöinen, myös pintaa syvemmältä kestävä.
        Ollakseen aidosti arvokasta, koodin täytyy olla myös ymmärrettävää ja
        ylläpidettävää. En rakenna tilapäisiä purkkaviritelmiä, vaan
        kokonaisuuksia, jotka kestävät aikaa ja arkea.
      </p>
    </div>
    <div class="p-4 reveal">
      <Icon
        name="design-ideas-svgrepo-com"
        class="md:h10 h-8 md:w-10 w-8 mb-4"
      />
      <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
        Design
      </h2>
      <p class="text-content-primary max-w-lg">
        Kaikki suunnittelu lähtee ihmisestä. Olipa kyseessä monimutkainen
        ohjelmisto tai fyysinen konsepti, periaatteeni on tehdä asioita
        käyttäjää varten. Hyvä muotoilu on aivan samanlaista ongelmanratkaisua
        kuin insinöörityökin, työkalut ovat vain eri. Minun tehtäväni on toimia
        siltana teknisen toteutuksen ja ihmisen välillä, ja varmistaa, että
        käyttökokemus on looginen ja intuitiivinen.
      </p>
      <p class="text-content-primary max-w-lg pt-4">
        Asiakaslähtöisyys on leivottu selkärankaani ravintola-alalla ja olen
        myöhemmin kehittänyt sitä edelleen muotoiluopinnoissani. Tämä
        yhdistettynä insinööriyteen on yksi suurimmista vahvuuksistani.
      </p>
    </div>
    <div class="bg-brand-highlight p-8 rounded-2xl text-surface-primary reveal">
      <Icon name="carpentry-svgrepo-com" class="md:h10 h-8 md:w-10 w-8 mb-4" />
      <h2 class="text-2xl font-serif italic text-heading-primary mb-4">
        Tilaustyöt
      </h2>
      <p class="max-w-lg">
        Rakkaus luomiseen alkoi fyysisistä materiaaleista. Tekstiilityöt ovat
        kulkeneet mukanani lapsesta asti, ja ne ovat opettaneet konkreettisesti
        sen, mitä vaatii rakentaa jotain alusta loppuun omilla käsillä. Tämä
        tinkimätön "duunarimeininki" ja visuaalinen tarkkanäköisyys ovat
        tekemiseni selkäranka, joita olen kehittänyt ja kuljetan mukanani
        kaikessa tekemisessäni..
      </p>
      <p class="max-w-lg pt-4">
        Teen valikoiden fyysisiä tilaustöitä. Uutta verkkokauppaa odotellessa
        voit kurkata aiempia töitäni
        <Button
          variant="textLink"
          class="text-surface-primary hover:text-surface-primary! inline-flex underline p-0 md:p-0"
          href="https://www.instagram.com/christaeloranta/"
          ><Icon name="instagram-svgrepo-com" />Instagramista</Button
        > tai <Button
          variant="textLink"
          class="text-surface-primary hover:text-surface-primary! inline-flex underline p-0 md:p-0"
          href="https://archive.christaeloranta.fi"
          target="_blank">arkistoidulta verkkosivulta</Button
        >.
      </p>
    </div>
  </div>
  <Accordion>
    <AccordionItem itemId="accordion-flush-1">
      <Fragment slot="title"
        >Mitä tarkoitat sanoessasi, että olet tuuliviiri?</Fragment
      >
      <Fragment slot="answer">
        <p>
          Tuuliviiriys on jotain, mitä minulle on sanottu paljon. Ei siksi, että
          määrätiedottomasti pyörisin ympäriinsä, vaan koska
          mielenkiinnonkohteeni vaihtuvat usein ja teen monenlaisia asioita,
          usein myös samaan aikaan. Yleensä ollaan totuttu siihen, että
          ihmisellä on yksi selkeä ammatti tai jotenkin rajatut kiinnostuksen
          kohteet ja muu nähdään outona. "Tuuliviiriyteni" ansiosta olen
          kerryttänyt laaja-alaista osaamista useilta eri segmenteiltä.
        </p>
        <p class="mt-2">
          Tuuliviiriys tarkoittaa minulle myös kykyä reagoida muuttuviin
          vaatimukseen ja tarvittaessa pivotoida rajustikin. Asioiden puskeminen
          väkisin eteenpäin, koska näin on aina tehty, ei ole mielestäni
          mielekästä, vaan mielummin etsin tavan, jolle tuuli on myötäisempi.
        </p>
      </Fragment>
    </AccordionItem>
    <AccordionItem itemId="accordion-flush-4">
      <Fragment slot="title"
        >Ovatko sivustolla olevat kuosit sinun suunnittelemiasi?</Fragment
      >
      <Fragment slot="answer">
        <p>
          Ovat. Lapin yliopistossa opiskelin sisustus- ja tekstiilimuotoilua ja
          opintokokonaisuuteen sisältyi useita pintasuunnitteluprojekteja.
          Sivustolla on sekä painettavaksi, että kudottavaksi suunniteltuja
          kuoseja, joita nyt muokattu verkkokäyttöön sopiviksi.
        </p>
      </Fragment>
    </AccordionItem>

    <AccordionItem itemId="accordion-flush-2">
      <Fragment slot="title">Miten sinuun saa parhaiten yhteyden?</Fragment>
      <Fragment slot="answer">
        <p>
          Yhteystietoni löytyvät <Button
            variant="textLink"
            href="/contact"
            class="inline-flex py-0! px-1!"
          >
            yhteystietojen sivulta</Button
          >.
        </p>
        <p class="mt-2">
          Minulle voi matalalla kynnyksellä huudella Instagramissa tai
          LinkedInissä. Myös sähköpostilla tai yhteydenottolomakkeella lähetetyt
          viestit tulevat perille. Pyrin vastaamaan parissa päivässä.
        </p>
      </Fragment>
    </AccordionItem>
    <AccordionItem itemId="accordion-flush-3">
      <Fragment slot="title">Millaisille yhteistöille olet avoin?</Fragment>
      <Fragment slot="answer">
        <p>
          Minulta voi kysellä yhteistyökuvioista liittyen oikeastaan mihin vaan.
          Erityisesti kiinnostavat projektit, joissa pääsee yhdistämään teknistä
          ja visuaalista osaamista, esimerkiksi erilainen tuotteistukseen ja
          konseptointiin liittyvä tekeminen, tilaustyöt tai protoilut.
        </p>
        <p class="mt-2">
          Vielä jonain päivänä brändään itseni "järkevämmin" ja keskityn vain
          yhteen asiaan, jotta myymisessä ja markkinoinnissa olisi selkeämpi
          punainen lanka. Se päivä ei ole kuitenkaan vielä tänään.
        </p>
      </Fragment>
    </AccordionItem>
  </Accordion>
</MainLayout>
<Content color="secondary">
  <ContactForm />
</Content>
