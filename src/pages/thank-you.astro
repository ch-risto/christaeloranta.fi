---
import StrippedLayout from "../layouts/StrippedLayout.astro";
import Button from "../components/ui/Button.astro";
---

<StrippedLayout
  title="Kiitos | Christa Eloranta"
  description="Kiitos viestistäsi, palaan asiaan mahdollisimman pian."
>
  <div class="flex flex-col items-center justify-center gap-4">
    <h1 class="md:text-6xl text-4xl font-serif italic">Kiitos viestistäsi!</h1>
    <p>Palaan asiaan mahdollisimman pian.</p>
    <Button class="mt-8" href="/">Palaa etusivulle</Button>
  </div>
</StrippedLayout>
