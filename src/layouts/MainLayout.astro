---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  headerColor?: "transparent" | "light" | "brand";
}
const { title, headerColor = "light" } = Astro.props as Props;
---

<BaseLayout title={title}>
  <Header headerColor={headerColor} />
  <main class="grow w-full mx-auto flex flex-col items-center justify-start">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal using IntersectionObserver
  // Respects prefers-reduced-motion via CSS; the JS still adds the class so
  // layout never breaks if CSS transitions are skipped.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.12 },
  );

  document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
