---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  headerColor?: "transparent" | "light" | "brand";
  offsetHeader?: boolean;
}
const {
  title,
  description,
  ogTitle,
  ogDescription,
  headerColor = "light",
  offsetHeader = false,
} = Astro.props as Props;
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
>
  <Header headerColor={headerColor} />
  <main
    class={`grow w-full mx-auto flex flex-col items-center justify-start ${offsetHeader ? "pt-16 md:pt-20" : ""}`}
  >
    <slot />
  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal using IntersectionObserver
  // Respects prefers-reduced-motion via CSS; the JS still adds the class so
  // layout never breaks if CSS transitions are skipped.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.12 },
  );

  document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
