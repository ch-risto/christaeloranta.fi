---
import "../styles/global.css";
import "../styles/fonts.css";
import { getPersonSchema } from "../data/schema";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://christaeloranta.fi/images/christaelorantajakokuva.webp",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const personSchema = getPersonSchema(canonicalUrl.toString());
---

<!doctype html>
<html lang="fi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#215154" />
    <meta name="color-scheme" content="light dark" />
    <link
      id="favicon-light"
      rel="icon"
      type="image/png"
      href="/logos/ch_.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      id="favicon-dark"
      rel="icon"
      type="image/png"
      href="/logos/ch_white.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      id="favicon-fallback"
      rel="icon"
      type="image/png"
      href="/logos/ch_.png"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script is:inline>
      const darkModeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const lightFavicon = document.getElementById("favicon-light");
      const darkFavicon = document.getElementById("favicon-dark");
      const fallbackFavicon = document.getElementById("favicon-fallback");

      const syncFavicon = () => {
        const useDark = darkModeQuery.matches;
        const selectedHref = useDark
          ? darkFavicon?.getAttribute("href")
          : lightFavicon?.getAttribute("href");

        if (fallbackFavicon && selectedHref) {
          fallbackFavicon.setAttribute("href", selectedHref);
        }
      };

      syncFavicon();
      darkModeQuery.addEventListener("change", syncFavicon);
    </script>
  </head>
  <body
    class="min-h-screen flex flex-col font-sans bg-surface-primary text-content-primary"
  >
    <slot />
  </body>
</html>
