---
import "../styles/global.css";
import "../styles/fonts.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Oletuskuvaus" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logos/ch_.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Christa Eloranta - {title}</title>
    <meta name="description" content={description} />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.turbo.js"
    ></script>
  </head>
  <body
    class="min-h-screen flex flex-col font-sans bg-surface-primary text-content-primary"
  >
    <slot />
  </body>
</html>
