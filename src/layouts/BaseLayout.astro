---
import "../styles/global.css";
import "../styles/fonts.css";
import { getPersonSchema } from "../data/schema";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://christaeloranta.fi/images/christaelorantajakokuva.webp",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const personSchema = getPersonSchema(canonicalUrl.toString());
---

<!doctype html>
<html lang="fi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#215154" />
    <link rel="icon" type="image/svg+xml" href="/logos/ch_.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.turbo.js"
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body
    class="min-h-screen flex flex-col font-sans bg-surface-primary text-content-primary"
  >
    <slot />
  </body>
</html>
