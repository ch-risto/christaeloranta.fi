---
interface Props {
  type?: "text" | "email" | "tel" | "textarea";
  label: string;
  name: string;
  placeholder?: string;
  required?: boolean;
  error?: string;
}

const {
  type = "text",
  label,
  name,
  placeholder = "",
  required = false,
  error = "",
} = Astro.props as Props;

const borderClasses = error
  ? "border-red-500 focus:border-red-500 focus:ring-red-500"
  : "border-brand focus:border-brand focus:ring-brand";

const baseInputClasses = `
    w-full p-2 border-b bg-surface-primary
    `;
---

<div class="flex flex-col gap-1 w-full">
  <label for={name} class="text-sm font-medium text-content-primary">
    {label}
  </label>
  {
    type === "textarea" ? (
      <textarea
        id={name}
        name={name}
        placeholder={placeholder}
        required={required}
        class={baseInputClasses + borderClasses}
        rows="4"
      />
    ) : (
      <input
        id={name}
        type={type}
        name={name}
        placeholder={placeholder}
        required={required}
        class={baseInputClasses + borderClasses}
      />
    )
  }
  {
    error && (
      <p class="text-red-500 text-sm" id={`${name}-error`}>
        {error}
      </p>
    )
  }
</div>
