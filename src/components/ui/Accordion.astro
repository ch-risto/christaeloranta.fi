---
interface Props {
  id?: string;
}

const { id = "accordion-flush" } = Astro.props as Props;
---

<div
  {id}
  data-accordion="collapse"
  data-active-classes="bg-neutral-primary text-heading"
  data-inactive-classes="text-body"
  class="max-w-5xl w-full mx-auto"
>
  <slot />
</div>

<script>
  // Custom accordion handler - only one item open at a time
  document.addEventListener("click", (e) => {
    const button = e.target.closest("[data-accordion-target]");
    if (!button) return;

    const targetId = button.getAttribute("data-accordion-target");
    if (!targetId) return;

    const targetElement = document.querySelector(targetId);
    if (!targetElement) return;

    const isCurrentlyHidden = targetElement.classList.contains("hidden");

    // Close all other accordion items in this accordion
    const accordionId = button.closest("[data-accordion]")?.id;
    if (accordionId) {
      const accordion = document.getElementById(accordionId);
      const allButtons = accordion?.querySelectorAll("[data-accordion-target]");

      allButtons?.forEach((btn) => {
        const btnTargetId = btn.getAttribute("data-accordion-target");
        const btnTarget = document.querySelector(btnTargetId);
        if (btnTarget && btnTarget !== targetElement) {
          btnTarget.classList.add("hidden");
          btn.setAttribute("aria-expanded", "false");
        }
      });
    }

    // Toggle current item
    if (isCurrentlyHidden) {
      targetElement.classList.remove("hidden");
      button.setAttribute("aria-expanded", "true");
    } else {
      targetElement.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
    }
  });
</script>
