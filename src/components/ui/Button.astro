---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  variant?: "primary" | "secondary";
}

const { href, type = "button", class: className = "" } = Astro.props;

const classes =
  `inline-flex justify-center rounded-md bg-brand px-4 py-2 font-semibold text-surface-tertiary hover:bg-brand-hover ${className}`.trim();
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
