---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  type = "button",
  class: className = "",
  variant: variantValue = "primary",
} = Astro.props;

const isExternalLink = typeof href === "string" && /^https?:\/\//.test(href);

const classes =
  `inline-flex justify-center items-center gap-1 uppercase font-sans-secondary px-4 py-2 cursor-pointer rounded-sm
   transition-all duration-200 ease-out
   active:scale-95
   focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current
   motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-md
   ${className}`.trim();

const variantClasses = {
  primary: "bg-brand text-surface-primary hover:bg-brand/85",
  secondary:
    "bg-brand-highlight text-content-primary hover:bg-brand-highlight/85",
};

// const variant = variantClasses[variantValue];
---

{
  href ? (
    <a
      href={href}
      target={isExternalLink ? "_blank" : undefined}
      rel={isExternalLink ? "noopener noreferrer" : undefined}
      class={classes + " " + variantClasses[variantValue]}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes + " " + variantClasses[variantValue]}>
      <slot />
    </button>
  )
}
