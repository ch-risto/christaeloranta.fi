---
interface Props {
  heading?: string;
  intro?: string;
}

const { heading, intro } = Astro.props as Props;
---

<section class="w-full max-w-4xl mx-auto">
  {
    (heading || intro) && (
      <div class="max-w-3xl mx-auto text-center">
        {heading && (
          <h2 class="text-3xl md:text-4xl font-serif-secondary italic text-heading-primary">
            {heading}
          </h2>
        )}
        {intro && (
          <p class="mt-3 text-content-primary font-sans-secondary leading-7 tracking-tight">
            {intro}
          </p>
        )}
      </div>
    )
  }

  <div class="relative mt-8 md:mt-10">
    <div
      class="absolute left-5 md:left-6 top-2 bottom-2 w-px bg-brand-background/25"
    >
    </div>
    <div class="flex flex-col gap-4">
      <slot />
    </div>
  </div>
</section>
