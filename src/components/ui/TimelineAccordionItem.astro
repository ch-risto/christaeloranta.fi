---
import { Icon } from "astro-icon/components";
import Tag, { type TagType } from "./Tag.astro";

interface Props {
  period: string;
  icon?: string;
  title: string;
  summary?: string;
  highlights?: Record<string, string>;
  open?: boolean;
}

const {
  period,
  icon = "",
  title,
  summary = "",
  highlights,
  open = false,
} = Astro.props as Props;
---

<details
  class="group rounded-2xl border border-brand-background/10 bg-surface-primary shadow-sm transition-shadow open:shadow-md"
  open={open}
>
  <summary
    class="flex cursor-pointer list-none items-start gap-4 px-4 py-4 md:px-6 md:py-5"
  >
    <span
      class="relative -left-3 z-10 mt-1 flex shrink-0 items-center justify-center transition-colors group-open:text-brand-highlight bg-surface-primary py-1 rounded-full"
    >
      {icon && <Icon name={icon as string} class="h-8 w-8 " />}
    </span>

    <span class="min-w-0 flex-1 text-left">
      <span
        class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.22em] text-content-tertiary"
      >
        <span class="font-sans-secondary">{period}</span>
      </span>
      <span
        class="mt-1 block text-xl md:text-2xl font-serif-secondary italic text-content group-open:underline group-hover:underline"
      >
        {title}
      </span>
      <span
        class="mt-2 block text-sm md:text-base leading-7 tracking-tight text-content-primary font-sans-secondary"
      >
        {summary}
      </span>
      {
        highlights && Object.keys(highlights).length > 0 && (
          <span class="mt-3 flex flex-wrap gap-2 reveal-group">
            {Object.entries(highlights).map(([skill, type]) => (
              <Tag additionalClass="reveal" type={type as TagType}>
                {skill}
              </Tag>
            ))}
          </span>
        )
      }
    </span>
  </summary>

  <div
    class="border-t border-brand-background/10 px-4 pb-5 pt-0 md:px-6 md:pb-6"
  >
    <div
      class="ml-8 md:ml-10 pt-2 text-content-tertiary font-sans-secondary leading-7 tracking-tight"
    >
      <slot />
    </div>
  </div>
</details>
