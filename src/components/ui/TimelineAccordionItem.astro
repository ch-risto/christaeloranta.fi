---
interface Props {
  period: string;
  title: string;
  summary: string;
  highlights?: string[];
  open?: boolean;
}

const {
  period,
  title,
  summary,
  highlights,
  open = false,
} = Astro.props as Props;
---

<details
  class="group rounded-2xl border border-brand-background/10 bg-surface-primary shadow-sm transition-shadow open:shadow-md"
  open={open}
>
  <summary
    class="flex cursor-pointer list-none items-start gap-4 px-4 py-4 md:px-6 md:py-5"
  >
    <span
      class="relative z-10 mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2 border-brand-background bg-surface-primary transition-colors group-open:border-brand-highlight group-open:bg-brand-highlight"
    >
      <span
        class="h-1.5 w-1.5 rounded-full bg-brand-background transition-colors group-open:bg-surface-primary"
      ></span>
    </span>

    <span class="min-w-0 flex-1 text-left">
      <span
        class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.22em] text-content-tertiary"
      >
        <span class="font-sans-secondary">{period}</span>
      </span>
      <span
        class="mt-1 block text-xl md:text-2xl font-serif-secondary italic text-content-secondary"
      >
        {title}
      </span>
      <span
        class="mt-2 block text-sm md:text-base leading-7 tracking-tight text-content-primary font-sans-secondary"
      >
        {summary}
      </span>
      {
        highlights && highlights.length > 0 && (
          <span class="mt-3 flex flex-wrap gap-2">
            {highlights.map((highlight) => (
              <span class="inline-flex items-center rounded-full bg-brand-background/8 px-3 py-1 text-xs uppercase tracking-[0.18em] text-brand-background">
                {highlight}
              </span>
            ))}
          </span>
        )
      }
    </span>

    <!-- <span
            class="mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand-background/15 bg-surface-secondary text-brand-background transition-transform duration-200 group-open:rotate-180"
        >
            <svg
                aria-hidden="true"
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M6 9L12 15L18 9"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </span> -->
  </summary>

  <div
    class="border-t border-brand-background/10 px-4 pb-5 pt-0 md:px-6 md:pb-6"
  >
    <div
      class="ml-8 md:ml-10 pt-2 text-content-primary font-sans-secondary leading-7 tracking-tight"
    >
      <slot />
    </div>
  </div>
</details>
