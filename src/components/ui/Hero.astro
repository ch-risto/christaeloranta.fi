---
interface HeroProps {
  title: string;
  description: string;
  imageUrl?: string;
  type?: "main" | "secondary";
}
const { imageUrl, type = "main" } = Astro.props as HeroProps;

const headerType = {
  main: {
    height: "md:h-170 h-96",
    title: "md:text-9xl text-6xl",
    description:
      "text-content-tertiary leading-7 tracking-tight md:text-md text-s md:max-w-md px-2 mb-4",
    tags: "flex flex-row flex-wrap tracking-wider gap-2 mb-2",
  },
  secondary: {
    height: "md:h-80 h-64",
    title: "md:text-5xl  text-4xl",
    description: "md:text-xl text-lg",
    tags: "bg-brand-highlight-secondary/50",
  },
};

const header = headerType[type];
---

<section
  class={`w-full grow bg-surface-secondary bg-center flex items-center justify-center ${header.height} bg-cover p-4 md:p-0`}
  style={imageUrl ? `background-image: url(${imageUrl});` : ""}
>
  <div
    class="w-full max-w-6xl justify-start bg-linear-to-r from-surface-primary from-20% to-transparent md:to-80% to-100% rounded-lg p-4 md:mt-24"
  >
    <div
      class={`${header.tags} motion-safe:animate-[fade-in-up_0.5s_ease-out_both]`}
    >
      <slot name="tags" />
    </div>
    <h1
      class={`font-serif text-heading-primary mb-2 max-w-2xl ${header.title} motion-safe:animate-[fade-in-up_0.55s_ease-out_both] anim-delay-1`}
    >
      <slot name="title" />
    </h1>
    <p
      class={`font-sans-secondary uppercase ${header.description} motion-safe:animate-[fade-in-up_0.55s_ease-out_both] anim-delay-2`}
    >
      <slot name="description" />
    </p>
    <div
      class="motion-safe:animate-[fade-in-up_0.55s_ease-out_both] anim-delay-3"
    >
      <slot name="additional-content" />
    </div>
  </div>
</section>
