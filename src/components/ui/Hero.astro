---
interface HeroProps {
  title: string;
  description: string;
  imageUrl?: string;
  imageClass?: string;
  type?: "main" | "secondary";
}
const {
  imageUrl,
  imageClass = "bg-[length:65%]",
  type = "main",
} = Astro.props as HeroProps;

const headerType = {
  main: {
    container: "min-h-[100svh] md:h-dvh max-h-[950px] justify-center",
    title: "md:text-8xl text-6xl",
    description: "",
    tags: "flex flex-row flex-wrap tracking-wider gap-2 mb-2 reveal-group",
  },
  secondary: {
    container: "md:h-120 h-80 justify-end pb-8",
    title: "md:text-8xl text-4xl",
    description: "",
    tags: "bg-brand-highlight-secondary/50",
  },
};

const header = headerType[type];
---

<section
  class={`w-full grow bg-brand-background flex flex-col items-center ${header.container} p-4 relative`}
>
  {
    imageUrl && (
      <>
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true" />
        <div
          class={`absolute inset-0 pointer-events-none ${imageClass} motion-safe:animate-[fade-in_0.55s_ease-out_both]`}
          style={`background-image: url(${imageUrl}); background-repeat: repeat; filter: brightness(0) saturate(100%) invert(35%) sepia(8%) saturate(3258%) hue-rotate(138deg) brightness(102%) contrast(85%);`}
        />
      </>
    )
  }
  <div
    class="w-full max-w-6xl justify-start bg-surface-primary/80 md:bg-transparent md:bg-[linear-gradient(to_right,var(--color-surface-primary)_10%,transparent_70%)] rounded-lg p-4 md:py-8 relative z-10"
  >
    <div class={header.tags}>
      <slot name="tags" />
    </div>
    <h1
      class={`font-serif text-heading-primary mb-2 max-w-2xl ${header.title}`}
    >
      <slot name="title" />
    </h1>
    <p
      class={`font-sans-secondary uppercase text-content-tertiary tracking-tight text-sm md:text-base leading-6 md:leading-7 md:max-w-md md:px-2 ${header.description} motion-safe:animate-[fade-in-up_0.55s_ease-out_both] anim-delay-2`}
    >
      <slot name="description" />
    </p>
    <div
      class="mt-4 motion-safe:animate-[fade-in-up_0.55s_ease-out_both] anim-delay-3"
    >
      <slot name="additional-content" />
    </div>
  </div>
</section>
