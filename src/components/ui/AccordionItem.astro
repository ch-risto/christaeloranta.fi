---
interface Props {
  title: string;
  itemId: string;
  isOpen?: boolean;
}

const { title, itemId, isOpen = false } = Astro.props as Props;
const headingId = `${itemId}-heading`;
const bodyId = `${itemId}-body`;
---

<h2 id={headingId}>
  <button
    type="button"
    class="flex items-center justify-between w-full py-5 text-xl font-serif-secondary rtl:text-right text-body border-b border-default gap-3 bg-surface-primary p-6"
    data-accordion-target={`#${bodyId}`}
    aria-expanded={isOpen ? "true" : "false"}
    aria-controls={bodyId}
  >
    <span>{title}</span>
    <svg
      data-accordion-icon
      class="w-5 h-5 rotate-180 shrink-0"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
      viewBox="0 0 24 24"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m5 15 7-7 7 7"></path>
    </svg>
  </button>
</h2>
<div id={bodyId} class={isOpen ? "" : "hidden"} aria-labelledby={headingId}>
  <div
    class="py-5 px-8 border-b border-default text-body font-sans-secondary tracking-tight leading-6 bg-surface-primary"
  >
    <slot />
  </div>
</div>
