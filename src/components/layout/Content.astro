---
interface Props {
  color?: "primary" | "secondary";
}

const { color = "primary" } = Astro.props as Props;

const colorClasses = {
  primary: "bg-surface-primary text-content-primary",
  secondary: "bg-surface-secondary text-content-secondary",
};

const bgColor = colorClasses[color];
---

<div
  class={`flex flex-col px-4 py-8 md:py-28 gap-8 md:gap-28 w-full ${bgColor}`}
>
  <slot />
</div>
