---
import Button from "../ui/Button.astro";
---

<header
  class="sticky md:fixed top-0 left-0 w-full z-50 bg-surface-secondary/95 md:bg-surface-secondary/75 md:backdrop-blur-sm"
>
  <nav class="max-w-6xl mx-auto px-4 py-2">
    <div class="flex items-center justify-between gap-3">
      <a
        class="block leading-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current
   motion-safe:hover:-translate-y-0.5"
        href="/"
      >
        <img
          src="/logos/ch_.svg"
          alt="Christa Eloranta"
          class="block h-12 sm:h-14 w-auto"
          style="filter: brightness(0) saturate(100%) invert(13%) sepia(45%) saturate(580%) hue-rotate(115deg) brightness(97%) contrast(89%);"
        />
      </a>

      <details class="relative md:hidden nav-menu">
        <summary
          class="list-none flex h-10 w-10 items-center justify-center rounded-sm text-content-primary cursor-pointer [&::-webkit-details-marker]:hidden"
          aria-label="Avaa valikko"
        >
          <span class="sr-only">Avaa valikko</span>
          <span class="hamburger" aria-hidden="true">
            <span class="hamburger-line hamburger-line-top"></span>
            <span class="hamburger-line hamburger-line-bottom"></span>
          </span>
        </summary>
        <ul
          class="absolute right-0 mt-2 min-w-60 rounded-sm bg-surface-primary p-2 shadow-md flex flex-col gap-1"
        >
          <li>
            <Button href="/" variant="navLink">Etusivu</Button>
          </li>
          <li>
            <Button href="/about" variant="navLink">Minusta</Button>
          </li>
          <li>
            <Button href="/contact" variant="navLink">Ota yhteyttä</Button>
          </li>
        </ul>
      </details>

      <ul
        class="hidden md:flex md:flex-wrap items-center gap-3 md:ml-auto w-auto"
      >
        <li>
          <Button href="/" variant="navLink">Etusivu</Button>
        </li>
        <li>
          <Button href="/about" variant="navLink">Minusta</Button>
        </li>
        <li>
          <Button href="/contact" variant="navLink">Ota yhteyttä</Button>
        </li>
      </ul>
    </div>
  </nav>
</header>
